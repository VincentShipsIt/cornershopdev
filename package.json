{
  "name": "cornershopdev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bunx --bun prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "design:lint": "designmd lint DESIGN.md && designmd lint docs/brand/cornershopdev/DESIGN.md",
    "test": "bun test",
    "db:migrate:status": "bunx --bun prisma migrate status",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "operator:grant-superadmin": "bun scripts/grant-superadmin.ts",
    "operator:import:le-petit-meunier": "bun scripts/import-le-petit-meunier.ts",
    "workflow:migrate": "bun node_modules/@workflow/world-postgres/bin/setup.js",
    "postinstall": "bunx --bun prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@base-ui/react": "^1.6.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@workflow/world-postgres": "^4.3.1",
    "ai": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.1.0",
    "resend": "^6.17.2",
    "shadcn": "^4.13.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@google/design.md": "^0.3.0",
    "@next/env": "16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
