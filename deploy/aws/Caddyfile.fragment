# BEGIN CORNERSHOPDEV
api.cornershop.dev {
	@workflowHandlers path /.well-known/workflow/v1/flow* /.well-known/workflow/v1/step*
	respond @workflowHandlers 404
	reverse_proxy cornershopdev:3000
}

domains.cornershop.dev {
	respond 404
}

https:// {
	tls {
		on_demand
	}
	@workflowHandlers path /.well-known/workflow/v1/flow* /.well-known/workflow/v1/step*
	respond @workflowHandlers 404
	reverse_proxy cornershopdev:3000
}
# END CORNERSHOPDEV
