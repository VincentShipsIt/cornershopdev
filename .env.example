# Public application and routing
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORNERSHOPDEV_API_ORIGIN=
PLATFORM_HOSTNAMES=localhost,cornershop.dev,www.cornershop.dev,api.cornershop.dev,domains.cornershop.dev
PUBLIC_APP_IP=
CUSTOM_DOMAIN_CNAME=domains.cornershop.dev

# PostgreSQL / Prisma 7. Never reuse production credentials locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cornershopdev?schema=public

# OpenRouter handles structured text generation and model routing.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openrouter/auto

# AI Gateway handles optional image enhancement.
AI_TEXT_MODEL=openai/gpt-5.4
AI_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
AI_GATEWAY_API_KEY=

# Durable self-hosted import workflows
WORKFLOW_ENABLED=false
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
WORKFLOW_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/cornershopdev?schema=public
WORKFLOW_POSTGRES_JOB_PREFIX=cornershopdev_
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=2
WORKFLOW_POSTGRES_MAX_POOL_SIZE=4

# Public preview rate limiting
REDIS_URL=redis://localhost:6379

# Persistent image storage
AWS_REGION=us-west-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=https://assets.cornershop.dev

# Authenticates external readiness probes. Generate at least 32 random bytes.
HEALTHCHECK_TOKEN=

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=

# Claim links and email delivery
CLAIM_TOKEN_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
# The floor, not the identity. A launched niche declares its own sender in
# `src/lib/verticals/<niche>/marketing.ts` and that always wins — these two only
# cover a niche with no verified sending domain of its own yet.
EMAIL_FROM=Cornershopdev <hello@cornershop.dev>
# Where a reply lands when the fallback above was used. Leave unset and the
# header is simply omitted.
EMAIL_REPLY_TO=hello@cornershop.dev
