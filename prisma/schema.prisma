generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Vertical {
  RESTAURANT
  BEAUTY
}

enum SiteStatus {
  PROSPECT
  PREVIEW_READY
  CLAIMED
  LIVE
  PAUSED
}

enum BookingRequestStatus {
  NEW
  NOTIFIED
  CONTACTED
  CLOSED
}

enum ImportStatus {
  QUEUED
  CRAWLING
  EXTRACTING
  GENERATING
  READY
  FAILED
}

enum IntegrationType {
  BOOKING
  ORDERING
  DELIVERY
  SOCIAL
  ANALYTICS
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ImageProvenance {
  OFFICIAL
  OWNER
  PERMISSIONED_UGC
}

enum PlatformRole {
  USER
  SUPERADMIN
}

enum AnalyticsEventType {
  SITE_VIEW
  CTA_CLICK
  LEAD_CREATED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  sites         Site[]
  subscriptions Subscription[]
}

model Membership {
  id             String       @id @default(cuid())
  role           String       @default("owner")
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Site {
  id                   String            @id @default(cuid())
  slug                 String            @unique
  name                 String
  eyebrow              String?
  description          String?
  address              String?
  phone                String?
  email                String?
  sourceUrl            String?
  sourceKey            String?           @unique
  logoUrl              String?
  heroImageUrl         String?
  heroOriginalImageUrl String?
  heroImageProvenance  ImageProvenance?
  autoEnhanceImages    Boolean           @default(true)
  defaultLocale        String            @default("en")
  translations         Json              @default("[]")
  vertical             Vertical          @default(RESTAURANT)
  attributes           Json              @default("{}")
  status               SiteStatus        @default(PROSPECT)
  organizationId       String?
  organization         Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  catalogSections      CatalogSection[]
  integrations         Integration[]
  importJobs           ImportJob[]
  domains              Domain[]
  siteVersions         SiteVersion[]
  claimInvitations     ClaimInvitation[]
  auditEvents          AuditEvent[]
  bookingRequests      BookingRequest[]
  analyticsEvents      AnalyticsEvent[]
}

model CatalogSection {
  id          String        @id @default(cuid())
  name        String
  description String?
  position    Int           @default(0)
  siteId      String
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items       CatalogItem[]
}

model CatalogItem {
  id               String           @id @default(cuid())
  name             String
  description      String?
  price            Decimal?         @db.Decimal(10, 2)
  currency         String           @default("EUR")
  imageUrl         String?
  originalImageUrl String?
  imageProvenance  ImageProvenance?
  attributes       Json             @default("{}")
  available        Boolean          @default(true)
  position         Int              @default(0)
  sectionId        String
  section          CatalogSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Integration {
  id       String          @id @default(cuid())
  type     IntegrationType
  provider String?
  label    String
  url      String
  position Int             @default(0)
  /// Owner's id inside the provider (an OpenTable `rid`). Only consumed after the
  /// provider's own anchored `idPattern` matches it — see `src/lib/booking-embed.ts`.
  venueId   String?
  enabled   Boolean         @default(true)
  siteId    String
  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([siteId, position])
}

model ImportJob {
  id            String       @id @default(cuid())
  status        ImportStatus @default(QUEUED)
  source        String
  sourceKey     String?
  workflowRunId String?
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  vertical      Vertical     @default(RESTAURANT)
  siteId        String?
  site          Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([sourceKey, createdAt])
}

model SiteVersion {
  id          String    @id @default(cuid())
  version     Int
  theme       Json
  content     Json
  publishedAt DateTime?
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([siteId, version])
}

model Domain {
  id                String    @id @default(cuid())
  hostname          String    @unique
  verified          Boolean   @default(false)
  verificationToken String    @unique
  verifiedAt        DateTime?
  siteId            String
  site              Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ClaimInvitation {
  id                      String    @id @default(cuid())
  email                   String
  tokenHash               String    @unique
  expiresAt               DateTime
  acceptedAt              DateTime?
  stripeCheckoutSessionId String?   @unique
  stripePriceId           String?
  checkoutAttempt         Int       @default(0)
  checkoutReturnTokenHash String?
  checkoutReturnExpiresAt DateTime?
  siteId                  String
  site                    Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())

  @@index([siteId, email])
}

model Subscription {
  id                   String             @id @default(cuid())
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  lastStripeEventAt    DateTime?
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model StripeWebhookEvent {
  eventId         String   @id
  type            String
  stripeCreatedAt DateTime
  processedAt     DateTime @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  type      String
  actor     String?
  metadata  Json?
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
}

model BookingRequest {
  id          String               @id @default(cuid())
  siteId      String
  site        Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  requestedAt DateTime?
  partySize   Int?
  notes       String?              @db.Text
  status      BookingRequestStatus @default(NEW)
  notifiedAt  DateTime?
  contactedAt DateTime?
  closedAt    DateTime?
  source      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([siteId, status, createdAt])
}

model AnalyticsEvent {
  id         String             @id @db.Uuid
  visitId    String             @db.Uuid
  type       AnalyticsEventType
  siteId     String
  site       Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  occurredAt DateTime           @default(now())

  @@index([siteId, occurredAt, type])
  @@index([occurredAt])
}
